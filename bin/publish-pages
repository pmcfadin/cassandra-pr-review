#!/bin/sh
# Merge local reports/ into the published GitHub Pages site and push the gh-pages branch.
# The site branch holds only generated files; main never contains reports.
#
# The scheduled workflow also publishes reports for many PRs, so this starts from the current
# gh-pages contents (fetched first), never deletes a published report, and keeps a richer published
# report (code review or build results for the same head) over a plainer local one.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SITE="$ROOT/.work/site"

rm -rf "$SITE"
git -C "$ROOT" worktree prune
if git -C "$ROOT" ls-remote --exit-code --heads origin gh-pages >/dev/null 2>&1; then
  git -C "$ROOT" fetch --quiet origin gh-pages
  git -C "$ROOT" worktree add --quiet -B gh-pages "$SITE" FETCH_HEAD
elif git -C "$ROOT" show-ref --quiet refs/heads/gh-pages; then
  git -C "$ROOT" worktree add --quiet "$SITE" gh-pages
else
  git -C "$ROOT" worktree add --quiet --orphan -b gh-pages "$SITE"
fi

PYTHONPATH="$ROOT" python3 - "$ROOT/reports" "$SITE" <<'PY'
import sys
from cpr import site
rows, actions = site.merge(sys.argv[1], sys.argv[2])
for n, a in sorted(actions.items()):
    print(f"#{n}: {a}")
print(f"{len(rows)} report(s) on the site")
PY

git -C "$SITE" add -A
if git -C "$SITE" diff --cached --quiet; then
  echo "site unchanged"
else
  git -C "$SITE" -c commit.gpgsign=false commit --quiet -m "Publish PR review reports"
  git -C "$SITE" push --quiet origin gh-pages
  echo "pushed gh-pages"
fi
git -C "$ROOT" worktree remove --force "$SITE"
